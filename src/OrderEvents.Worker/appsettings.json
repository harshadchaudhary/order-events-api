{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "Database": {
    "Provider": "SqlServer",
    "ConnectionString": "Server=localhost,1433;Database=OrderEvents;User Id=sa;Password=Your_password123;TrustServerCertificate=True"
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092",
